<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Parque dos Dinossauros</title>
    <!-- Apenas estilos: Bootstrap CSS, sem componentes JavaScript. -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
  
    <style>
        :root {
            --bs-primary: #17634b;
            --bs-primary-rgb: 23, 99, 75;
            --bs-link-color: #17634b;
            --bs-link-hover-color: #104633;
            --bs-body-color: #263d34;
            --bs-body-bg: #f3f6f3;
            --bs-border-color: #dce5df;
        }
        body {
            max-width: 1120px;
            min-height: 100vh;
            margin: 0 auto;
            padding: 40px 28px;
            font-size: 1rem;
            line-height: 1.65;
        }
        body > h3:first-of-type {
            padding: 28px;
            margin-bottom: 20px;
            border-radius: 16px;
            background: #163f32;
            color: #fff;
            font-size: clamp(1.25rem, 3vw, 1.8rem);
            font-weight: 700;
            box-shadow: 0 8px 24px #163f3212;
        }
        h3 { margin: 24px 0 16px; font-weight: 650; letter-spacing: -.02em; }
        p { color: #617268; margin-bottom: 12px; }
        a { text-decoration: none; }
        body > a {
            display: inline-block;
            padding: 9px 16px;
            margin: 0 6px 20px 0;
            border: 1px solid var(--bs-border-color);
            border-radius: 8px;
            background: #fff;
            font-weight: 600;
        }
        body > div {
            margin-top: 24px;
            padding: 28px;
            background: #fff;
            border: 1px solid var(--bs-border-color);
            border-radius: 14px;
            box-shadow: 0 4px 18px #163f3206;
        }
        body > div > h3:first-child { margin-top: 0; }
        table {
            width: 100%;
            margin: 20px 0;
            border-collapse: separate;
            border-spacing: 0;
            background: #fff;
            border: 1px solid var(--bs-border-color);
            border-radius: 10px;
            overflow: hidden;
        }
        body > table:first-of-type:empty { display: none; }
        td { padding: 16px 18px; border-bottom: 1px solid #e8eee9; vertical-align: middle; }
        tr:first-child td { background: #eaf1ec; color: #244c3b; font-weight: 650; }
        tr:last-child td { border-bottom: 0; }
        td h3, td p { margin: 0; font-size: inherit; color: inherit; letter-spacing: normal; }
        td a { display: inline-block; padding: 5px 8px; border-radius: 6px; }
        form { max-width: 760px; margin-top: 24px; }
        form p { margin: 18px 0 6px; color: #304c3e; font-weight: 600; }
        input, select, textarea {
            display: block;
            width: 100%;
            min-height: 44px;
            padding: 10px 14px;
            color: var(--bs-body-color);
            background: #fff;
            border: 1px solid #cbd8cf;
            border-radius: var(--bs-border-radius);
            font: inherit;
        }
        input::placeholder, textarea::placeholder { color: #85938b; }
        textarea { min-height: 128px; resize: vertical; }
        input:focus, select:focus, textarea:focus {
            outline: 0;
            border-color: #69a78a;
            box-shadow: 0 0 0 .25rem #17634b20;
        }
        form br { display: none; }
        button {
            padding: 10px 22px;
            margin: 24px 8px 0 0;
            border: 1px solid var(--bs-primary);
            border-radius: var(--bs-border-radius);
            background: var(--bs-primary);
            color: #fff;
            font: inherit;
            font-weight: 600;
        }
        button[type="reset"] { background: #fff; color: #52645a; border-color: #cbd8cf; }
        button:focus-visible, a:focus-visible { outline: 3px solid #69a78a; outline-offset: 3px; }
        footer { margin-top: 48px; padding-top: 20px; border-top: 1px solid var(--bs-border-color); color: #738278; font-size: .875rem; }
        @media (max-width: 640px) {
            body { padding: 20px 14px; }
            body > h3:first-of-type { padding: 22px 18px; }
            body > div { padding: 20px 14px; }
            table { display: block; overflow-x: auto; }
            td { padding: 12px; min-width: 110px; }
            button { padding: 10px 16px; }
        }
    </style>
</head>
<body>
    <h3>Sistema de Gerenciamento de Parque de Dinossauros</h3>
    <table>
        <tr><a href="/dinossauro">Dinossauros / </a></tr>
        <tr><a href="/especie">Espécies / </a></tr>
    </table>
