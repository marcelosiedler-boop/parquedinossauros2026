<%- include('../cabecalho')%>
    <div>
        <tr><a href="../especie"> ← Voltar </a></tr> 
    <h3>Nova Espécie</h3>

    <form method="post">
        <p>Nome da Espécie</p>
        <input type="text" placeholder="Ex: Theropoda, Sauropoda, Ceratopsia..." name="nome">
        <br><br>
        <p>Período Geológico</p>
        <input type="text" placeholder="Ex: Triássico, Jurássico, Cretáceo..." name="periodo">

        <br><br>
        <button type="submit">Adicionar</button>
        <button type="reset">Cancelar</button>
    </form>
    </div>

</body>
</html>